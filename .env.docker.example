APP_NAME="Medical Voice RAG AI Module"
APP_VERSION="1.0.0"
APP_ENV=docker
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

API_KEYS="key-webapp-abc123,key-mobile-xyz789"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,*"
RATE_LIMIT_PER_MINUTE=60

MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=healthcare_db
MYSQL_USER=healthcare_user
MYSQL_PASSWORD=healthcare_password
DATABASE_URL=mysql+pymysql://healthcare_user:healthcare_password@mysql:3306/healthcare_db?charset=utf8mb4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=60
DB_WRITE_TIMEOUT=60

USE_MOCK_LLM=false
USE_MOCK_RETRIEVER=false

NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=
ALLOW_LOCAL_GRAPH_FALLBACK=true
USE_NEO4J_CORPUS_FOR_FAISS=false
REBUILD_FAISS_ON_START=false

MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
MODEL_LOAD_IN_4BIT=true
MODEL_TORCH_DTYPE=float16
MODEL_MAX_NEW_TOKENS=256
MODEL_TEMPERATURE=0.2
MODEL_REPETITION_PENALTY=1.1
MODEL_ATTENTION_IMPL=sdpa
LLM_DEVICE=cuda
LLM_MODEL_PATH=Qwen/Qwen2.5-7B-Instruct
LLM_MAX_CONCURRENT_REQUESTS=auto
LLM_CONCURRENCY_RESERVED_VRAM_GB=4
LLM_CONCURRENCY_ESTIMATED_REQUEST_VRAM_GB=4
LLM_CONCURRENCY_MAX_AUTO=4

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cuda
CROSS_ENCODER_DEVICE=cuda
USE_FAISS_GPU=false
VECTORSTORE_PATH=artifacts/vectorstore/medical_faiss_v4
BM25_K=3
FAISS_K=3
RERANK_TOP_N=3
USE_HYDE=false
USE_CROSS_ENCODER=false
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_GROUNDING_MODE=strict

ENABLE_STT=false
ENABLE_TTS=false
STT_BACKEND=whisper
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
STT_MODEL_DIR=artifacts/models/sherpa-onnx-zipformer-vi-30M-int8-2026-02-09
TTS_BACKEND=edge_tts
TTS_VOICE_ID=HoaiMy
AUDIO_OUTPUT_DIR=artifacts/audio

MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=medical_voice_rag_v4
SKIP_LEGACY_SERVICES=true
